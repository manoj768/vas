# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for self-hosted MongoDB Community or MongoDB Atlas
# Example: mongodb://username:password@localhost:27017/evalo_valuation?authSource=admin
MONGODB_URI=

# MONGODB_DB_NAME: Target database name
MONGODB_DB_NAME="evalo_valuation"

# JWT_SECRET: Secret for signing authentication tokens
JWT_SECRET="evalo_production_jwt_secret_2026"

# STORAGE_DRIVER: "local" or "s3" / "minio" for handling high-volume photos at 1 Lakh cases/month
STORAGE_DRIVER="local"

# VITE_API_URL: (Optional) Mobile App Backend URL for Android/iOS APK builds
# Example for tunnel: VITE_API_URL="https://your-tunnel.trycloudflare.com"
# Example for local Wi-Fi: VITE_API_URL="http://192.168.1.100:3000"
VITE_API_URL="https://YOUR-BACKEND-URL-OR-TUNNEL.trycloudflare.com"
